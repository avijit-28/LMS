@model LMS.ViewModels.CourseFormViewModel
@{
    ViewBag.Title = Model.CourseId > 0 ? "Edit Course" : "Create New Course";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-0">@(Model.CourseId > 0 ? "Edit Course" : "Create New Course")</h3>
                <p class="text-muted small">Configure curriculum metadata, category, difficulty level, and pricing</p>
            </div>
            <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Courses
            </a>
        </div>

        <div class="card card-custom p-4 p-md-5 shadow-sm">
            @using (Html.BeginForm(Model.CourseId > 0 ? "EditCourse" : "CreateCourse", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CourseId)
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Full-Stack Web Development Masterclass" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.CategoryId, "Subject / Category", new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(m => m.CategoryId, Model.Categories, "-- Select Subject / Category --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Level, new { @class = "form-label fw-semibold" })
                        <select name="Level" class="form-select">
                            <option value="Beginner" @(Model.Level == "Beginner" ? "selected" : "")>Beginner</option>
                            <option value="Intermediate" @(Model.Level == "Intermediate" ? "selected" : "")>Intermediate</option>
                            <option value="Advanced" @(Model.Level == "Advanced" ? "selected" : "")>Advanced</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Price, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text"><span class="rupee-symbol">&#8377;</span></span>
                            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", placeholder = "0.00 (Set 0 for Free)" })
                        </div>
                        <small class="text-muted">Enter 0 for free (in INR / &#8377;).</small>
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.DurationInHours, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.DurationInHours, new { @class = "form-control", placeholder = "15.5" })
                            <span class="input-group-text">Hours</span>
                        </div>
                        <small class="text-muted">Total content length.</small>
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.ValidityInDays, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.ValidityInDays, new { @class = "form-control", placeholder = "30" })
                            <span class="input-group-text">Days</span>
                        </div>
                        <small class="text-muted">Access window to finish coursework.</small>
                    </div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Thumbnail, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Thumbnail, new { @class = "form-control", placeholder = "https://example.com/thumbnail.jpg" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4, placeholder = "Describe learning outcomes, prerequisites, and syllabus goals..." })
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Publication Status</label>
                    <select name="Status" class="form-select">
                        <option value="Draft" @(Model.Status == "Draft" ? "selected" : "")>Draft (Private)</option>
                        <option value="Published" @(Model.Status == "Published" ? "selected" : "")>Published (Public & Enrollable)</option>
                        <option value="Archived" @(Model.Status == "Archived" ? "selected" : "")>Archived (Hidden from catalog)</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="@Url.Action("Courses", "Instructor")" class="btn btn-outline-secondary rounded-pill">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check2 me-1"></i> Save Course & Continue
                    </button>
                </div>
            }
        </div>
    </div>
</div>
