    // =========================================================================
    // 3. Direct In-Studio Study Planner
    // =========================================================================
    function launchStudioStudyPlanDirectly(overrideCourseId) {
        const select = document.getElementById('studio-course-select');
        let courseId = overrideCourseId;
        if (!courseId && select && select.value) {
            courseId = parseInt(select.value);
        }
        if (!courseId && window.studioEnrolledCourses && window.studioEnrolledCourses.length > 0) {
            courseId = window.studioEnrolledCourses[0].id;
        }
        if (!courseId) courseId = 1;

        let courseTitle = 'Machine Learning Fundamentals';
        if (window.studioEnrolledCourses && window.studioEnrolledCourses.length > 0) {
            const found = window.studioEnrolledCourses.find(c => c.id === courseId);
            if (found) courseTitle = found.title;
        } else if (select && select.selectedOptions && select.selectedOptions[0]) {
            courseTitle = select.selectedOptions[0].text;
        }

        const msgs = document.getElementById('studio-messages');
        if (!msgs) return;

        const userPromptHtml = `
            <div class="studio-msg user">
                <div class="studio-bubble">
                    <i class="bi bi-calendar-check me-1"></i> Formulate 14-Day Structured Study Plan for <strong>${escapeHtml(courseTitle)}</strong>
                </div>
                <span class="studio-time">Just now</span>
            </div>
        `;
        msgs.insertAdjacentHTML('beforeend', userPromptHtml);

        const loadingId = 'plan-loading-' + Date.now();
        const loadingHtml = `
            <div class="studio-msg assistant" id="${loadingId}">
                <div class="studio-bubble" style="border: 1px solid rgba(53, 201, 138, 0.35);">
                    <div class="d-flex align-items-center gap-2 text-success mb-1">
                        <span class="spinner-border spinner-border-sm text-success" role="status"></span>
                        <strong class="small">Formulating 14-Day Milestone Roadmap...</strong>
                    </div>
                    <div class="small text-white-50">Structuring progressive daily milestones, practice exercises, and exam checkpoints for ${escapeHtml(courseTitle)}.</div>
                </div>
            </div>
        `;
        msgs.insertAdjacentHTML('beforeend', loadingHtml);
        msgs.scrollTop = msgs.scrollHeight;

        fetch('/ChatBot/GenerateStudyPlan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                course_id: courseId,
                target_days: 14
            })
        })
        .then(res => res.json())
        .then(data => {
            const loadingEl = document.getElementById(loadingId);
            if (loadingEl) loadingEl.remove();

            if (!data.success || !data.plan) {
                const errHtml = `
                    <div class="studio-msg assistant">
                        <div class="studio-bubble text-danger border border-danger">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> ${escapeHtml(data.message || 'Failed to formulate study plan.')}
                        </div>
                    </div>
                `;
                msgs.insertAdjacentHTML('beforeend', errHtml);
                msgs.scrollTop = msgs.scrollHeight;
                return;
            }

            const formattedMarkdown = renderMarkdownSimple(data.plan.study_plan);
            const cardHtml = `
                <div class="studio-msg assistant w-100" style="max-width: 95%;">
                    <div class="studio-bubble p-4" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(53, 201, 138, 0.35); border-radius: 18px;">
                        <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-3 border-bottom border-secondary border-opacity-25 gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-pill px-3 py-1 bg-success text-white fw-bold" style="font-size: 12px;">
                                    <i class="bi bi-calendar2-range me-1"></i> 14-Day Revision Roadmap
                                </span>
                                <span class="small text-white-50">
                                    <i class="bi bi-journal-bookmark me-1 text-cyan"></i>${escapeHtml(courseTitle)}
                                </span>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-xs btn-outline-warning rounded-pill py-0 px-2" style="font-size: 11px;" onclick="promptChangeCourseForFeature('plan')">
                                    <i class="bi bi-arrow-left-right me-1"></i> Change Course
                                </button>
                                <button type="button" class="btn btn-xs btn-warning rounded-pill py-0 px-2 fw-bold" style="font-size: 11px;" onclick="launchStudioQuizDirectly(${courseId})">
                                    <i class="bi bi-patch-question-fill me-1"></i> Take Quiz on this
                                </button>
                            </div>
                        </div>
                        <div class="text-white studio-plan-content">
                            ${formattedMarkdown}
                        </div>
                    </div>
                    <span class="studio-time">Just now &bull; Agentic Study Planner</span>
                </div>
            `;
            msgs.insertAdjacentHTML('beforeend', cardHtml);
            msgs.scrollTop = msgs.scrollHeight;
        })
        .catch(err => {
            const loadingEl = document.getElementById(loadingId);
            if (loadingEl) loadingEl.remove();
            const errHtml = `
                <div class="studio-msg assistant">
                    <div class="studio-bubble text-danger">
                        <i class="bi bi-wifi-off me-1"></i> Error generating study roadmap.
                    </div>
                </div>
            `;
            msgs.insertAdjacentHTML('beforeend', errHtml);
            msgs.scrollTop = msgs.scrollHeight;
        });
    }

    function promptChangeCourseForFeature(feature) {
        const sel = document.getElementById('studio-course-select');
        if (!sel) return;
        sel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        sel.focus();
    }
    function escapeHtml(text) {
        if (!text) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function renderMarkdownSimple(text) {
        if (!text) return '';
        var t = escapeHtml(text);
        // Code blocks ```code```
        t = t.replace(/```([a-z]*)\n([\s\S]*?)```/g, function(match, lang, code) {
            return '<pre class="p-3 my-2 rounded-3 text-light overflow-auto" style="background: rgba(4, 24, 34, 0.95); border: 1px solid rgba(39, 184, 214, 0.3); font-size: 13px;"><code>' + code + '</code></pre>';
        });
        // Inline code `code`
        t = t.replace(/`([^`]+)`/g, '<code class="px-1 py-0.5 rounded text-cyan" style="background: rgba(39, 184, 214, 0.15); font-size: 90%;">$1</code>');
        // Bold **text**
        t = t.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        // Links [text](url)
        t = t.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_self" class="text-cyan text-decoration-underline fw-bold">$1</a>');
        // Bullet points
        t = t.replace(/^\s*[\*\-]\s+(.+)$/gm, '<li class="ms-3 mb-1">$1</li>');
        // Numbers
        t = t.replace(/^\s*(\d+)\.\s+(.+)$/gm, '<div class="ms-2 mb-1"><strong>$1.</strong> $2</div>');
        // Newlines
        t = t.replace(/\n\n+/g, '<br/><br/>');
        t = t.replace(/\n/g, '<br/>');
        return t;
    }
</script>
