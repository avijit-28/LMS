@model LMS.Models.Course
@{
    ViewBag.Title = "Secure Checkout - " + Model.Title;
    string stripePub = LMS.Services.EnvConfig.StripePublishableKey;
}

<div class="row justify-content-center py-4">
    <div class="col-lg-10">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Courses")" class="text-decoration-none text-info">Courses</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Details", "Courses", new { id = Model.CourseId })" class="text-decoration-none text-info">@Model.Title</a></li>
                <li class="breadcrumb-item active text-white-50" aria-current="page">Checkout</li>
            </ol>
        </nav>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-danger mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-info mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2 text-info"></i>@TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Course Summary -->
            <div class="col-md-5 order-md-2">
                <div class="card card-custom p-4 shadow-sm text-white payment-summary-card" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25); border-radius: 16px;">
                    <h5 class="fw-bold mb-3 text-white"><i class="bi bi-cart3 me-2 text-info"></i> Order Summary</h5>
                    
                    <!-- Course Title & Specs Box (High Contrast Dark Glassmorphism) -->
                    <div class="p-3 rounded-3 mb-3" style="background: rgba(4, 24, 34, 0.9); border: 1px solid rgba(39, 184, 214, 0.35);">
                        <h6 class="fw-bold mb-2 text-white fs-6" style="line-height: 1.4;">@Model.Title</h6>
                        <span class="badge px-2 py-1 rounded-pill fw-semibold" style="background: rgba(255, 122, 0, 0.2); color: #FF7A00; border: 1px solid rgba(255, 122, 0, 0.4);">
                            @(Model.Category?.CategoryName ?? "General")
                        </span>
                        <div class="small mt-2" style="color: #94A3B8;">
                            <i class="bi bi-clock me-1 text-info"></i> @Model.DurationInHours Hours Content &bull; Lifetime Access
                        </div>
                    </div>

                    <!-- Line Items Breakdown -->
                    <div class="d-flex justify-content-between mb-2 small" style="color: #94A3B8;">
                        <span>Curriculum Access</span>
                        <span class="text-white fw-semibold"><span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small" style="color: #94A3B8;">
                        <span>Verifiable Certificate</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small" style="color: #94A3B8;">
                        <span>Platform Processing</span>
                        <span class="text-success fw-bold">FREE (0.00)</span>
                    </div>
                    <hr class="my-2" style="border-color: rgba(255, 255, 255, 0.15);">
                    <div class="d-flex justify-content-between fs-4 fw-extrabold text-white mb-4">
                        <span>Total Due</span>
                        <span class="fw-bold text-cyan"><span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2")</span>
                    </div>

                    <!-- Stripe Security Badge -->
                    <div class="p-3 rounded-3 small mb-3" style="background: rgba(4, 24, 34, 0.75); border: 1px solid rgba(255, 255, 255, 0.12); color: #E2E8F0;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-dark px-2 py-1 border border-secondary border-opacity-25"><i class="bi bi-stripe text-info me-1"></i> Stripe Test Mode</span>
                            <span class="badge bg-success bg-opacity-25 text-success small border border-success border-opacity-25">Verified Live Key</span>
                        </div>
                        <div style="font-size: 0.8rem; color: #94A3B8;">
                            End-to-end encrypted sandbox test environment powered by official Stripe APIs.
                        </div>
                    </div>

                    <div class="p-3 rounded-3 small d-flex align-items-center gap-2" style="background: rgba(4, 24, 34, 0.75); border: 1px solid rgba(255, 255, 255, 0.12); color: #E2E8F0;">
                        <i class="bi bi-shield-check text-success fs-3"></i>
                        <span>Instant automated enrollment and full classroom unlock.</span>
                    </div>
                </div>
            </div>

            <!-- Payment Methods -->
            <div class="col-md-7 order-md-1">
                <div class="card card-custom p-4 p-md-5 shadow-sm text-white payment-gateway-card" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25); border-radius: 16px;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h4 class="fw-extrabold mb-0 tracking-tight text-white">Payment Gateway</h4>
                        <span class="badge bg-info bg-opacity-25 text-cyan fw-bold px-3 py-1 rounded-pill border border-info border-opacity-25">
                            <i class="bi bi-shield-lock-fill me-1"></i> 256-Bit SSL
                        </span>
                    </div>
                    <p class="small mb-4" style="color: #94A3B8;">Select your checkout gateway to authorize your course enrollment.</p>

                    <!-- Option A: Stripe Hosted Checkout (Official Redirect) -->
                    <div class="p-4 rounded-3 border border-2 border-primary bg-primary bg-opacity-10 mb-4 position-relative">
                        <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                    <i class="bi bi-credit-card fs-6"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-white">Stripe Hosted Checkout</h6>
                                    <small style="color: #94A3B8;">Pay securely on official Stripe page with Cards or Apple Pay / Google Pay</small>
                                </div>
                            </div>
                            <span class="badge bg-primary text-white rounded-pill px-2 py-1 small">Recommended</span>
                        </div>

                        <p class="small mb-3" style="color: #CBD5E1;">
                            Click below to open Stripe's hosted checkout simulator pre-configured with test cases.
                        </p>

                        @using (Html.BeginForm("CreateStripeCheckout", "Courses", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@Model.CourseId" />
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important; color: #FFFFFF !important;">
                                <i class="bi bi-box-arrow-up-right"></i> Launch Stripe Hosted Checkout (<span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2"))
                            </button>
                        }
                    </div>

                    <!-- Option B: Direct Stripe Card (In-Page Test Case Simulator) -->
                    <div class="card p-4 rounded-3 mb-4 shadow-none" style="background: rgba(4, 24, 34, 0.75); border: 1px solid rgba(255, 255, 255, 0.12);">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-white">
                                <i class="bi bi-credit-card-2-front text-info me-2"></i> Direct Card Checkout (Stripe API)
                            </h6>
                            <span class="badge rounded-pill px-2 py-1 small" style="background: rgba(39, 184, 214, 0.2); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.35);">Stripe Test Cases</span>
                        </div>

                        <!-- Test Case Preset Selector -->
                        <div class="mb-3 p-3 rounded-3" style="background: rgba(6, 35, 48, 0.85); border: 1px solid rgba(39, 184, 214, 0.3);">
                            <label class="form-label small fw-bold text-white mb-1 d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-sliders me-1 text-info"></i> Choose Stripe Test Case Scenario:</span>
                            </label>
                            <select id="stripeTestCaseSelect" class="form-select form-select-sm" onchange="applyStripeTestCase(this.value)" style="background-color: #062330 !important; color: #FFFFFF !important; border: 1px solid rgba(39, 184, 214, 0.4) !important;">
                                <option value="visa_success" selected>&#10004; Success - Visa (4242 4242 4242 4242)</option>
                                <option value="mastercard_success">&#10004; Success - Mastercard (5555 5555 5555 4444)</option>
                                <option value="declined">&#10008; Decline - Generic Card Declined (4000 0000 0000 0002)</option>
                                <option value="insufficient_funds">&#10008; Decline - Insufficient Funds (4000 0000 0000 9995)</option>
                                <option value="expired">&#10008; Decline - Expired Card (4000 0000 0000 0069)</option>
                                <option value="incorrect_cvc">&#10008; Decline - Incorrect Security Code (4000 0000 0000 0127)</option>
                            </select>
                            <div id="testCaseFeedback" class="small text-success mt-1 fw-semibold">
                                <i class="bi bi-check-circle me-1"></i> Pre-configured for immediate successful payment & classroom unlock.
                            </div>
                        </div>

                        @using (Html.BeginForm("Payment", "Courses", FormMethod.Post, new { id = "directPaymentForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@Model.CourseId" />
                            <input type="hidden" name="paymentMethod" value="Stripe Card (Test Gateway)" />

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-white mb-1">Card Number (Stripe Test Case)</label>
                                <div class="input-group">
                                    <span class="input-group-text border-end-0" style="background-color: #062330; border-color: rgba(255, 255, 255, 0.2);"><i class="bi bi-credit-card text-muted"></i></span>
                                    <input type="text" id="cardNumber" name="cardNumber" class="form-control border-start-0 font-monospace" style="background-color: #062330 !important; color: #FFFFFF !important; border: 1px solid rgba(255, 255, 255, 0.2) !important;" placeholder="4242 4242 4242 4242" value="4242 4242 4242 4242" required />
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <label class="form-label small fw-bold text-white mb-1">Exp Month</label>
                                    <input type="text" id="expMonth" name="expMonth" class="form-control font-monospace" style="background-color: #062330 !important; color: #FFFFFF !important; border: 1px solid rgba(255, 255, 255, 0.2) !important;" placeholder="12" value="12" maxlength="2" required />
                                </div>
                                <div class="col-4">
                                    <label class="form-label small fw-bold text-white mb-1">Exp Year</label>
                                    <input type="text" id="expYear" name="expYear" class="form-control font-monospace" style="background-color: #062330 !important; color: #FFFFFF !important; border: 1px solid rgba(255, 255, 255, 0.2) !important;" placeholder="2028" value="2028" maxlength="4" required />
                                </div>
                                <div class="col-4">
                                    <label class="form-label small fw-bold text-white mb-1">CVC / CVV</label>
                                    <input type="text" id="cvc" name="cvc" class="form-control font-monospace" style="background-color: #062330 !important; color: #FFFFFF !important; border: 1px solid rgba(255, 255, 255, 0.2) !important;" placeholder="123" value="123" maxlength="4" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-bold shadow-sm" style="background-color: #FF7A18 !important; border-color: #FF7A18 !important; color: #FFFFFF !important;">
                                <i class="bi bi-lock-fill me-1"></i> Authorize Direct Test Card (<span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2"))
                            </button>
                        }
                    </div>

                    <!-- Option C: Alternate Simulated Channels (High Contrast Dark Styling) -->
                    <div class="accordion" id="altPaymentAccordion">
                        <div class="accordion-item rounded-3 overflow-hidden shadow-none" style="background: rgba(4, 24, 34, 0.85); border: 1px solid rgba(39, 184, 214, 0.35);">
                            <h2 class="accordion-header" id="headingAlt">
                                <button class="accordion-button collapsed py-3 px-3 fw-bold small text-white custom-alt-accordion-btn" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAlt" aria-expanded="false" aria-controls="collapseAlt">
                                    <i class="bi bi-wallet2 me-2 text-warning fs-6"></i>
                                    <span>Other Payment Channels (UPI, Net Banking)</span>
                                </button>
                            </h2>
                            <div id="collapseAlt" class="accordion-collapse collapse" aria-labelledby="headingAlt" data-bs-parent="#altPaymentAccordion">
                                <div class="accordion-body p-3" style="background: rgba(4, 24, 34, 0.95); color: #FFFFFF; border-top: 1px solid rgba(39, 184, 214, 0.25);">
                                    @using (Html.BeginForm("Payment", "Courses", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="courseId" value="@Model.CourseId" />
                                        <div class="d-flex flex-column gap-2 mb-3">
                                            <label class="form-check p-3 rounded-3 d-flex align-items-center mb-0 channel-option" for="pmUpi" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(39, 184, 214, 0.3); cursor: pointer; transition: all 0.2s ease;">
                                                <input class="form-check-input me-3 mt-0" type="radio" name="paymentMethod" id="pmUpi" value="UPI / QR Payment (Mock)" checked style="cursor: pointer;">
                                                <span class="form-check-label fw-semibold text-white small">
                                                    <i class="bi bi-qr-code-scan text-success me-2 fs-6"></i> UPI / QR Code (GPay, PhonePe, Paytm)
                                                </span>
                                            </label>
                                            <label class="form-check p-3 rounded-3 d-flex align-items-center mb-0 channel-option" for="pmNet" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(39, 184, 214, 0.3); cursor: pointer; transition: all 0.2s ease;">
                                                <input class="form-check-input me-3 mt-0" type="radio" name="paymentMethod" id="pmNet" value="Net Banking (Mock)" style="cursor: pointer;">
                                                <span class="form-check-label fw-semibold text-white small">
                                                    <i class="bi bi-bank text-info me-2 fs-6"></i> Net Banking (All Indian Banks)
                                                </span>
                                            </label>
                                        </div>
                                        <button type="submit" class="btn w-100 rounded-pill py-2 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #FF7A00, #E65100); border: none;">
                                            <i class="bi bi-arrow-right-circle me-1"></i> Proceed with Alternative Channel
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Developer Key Inspection Footer -->
                    <div class="mt-4 pt-3 text-center small" style="border-top: 1px solid rgba(255, 255, 255, 0.12); color: #94A3B8;">
                        <div><i class="bi bi-key-fill text-warning me-1"></i> Stripe Publishable Key: <code class="small px-2 py-1 rounded" style="background: rgba(0, 0, 0, 0.4); color: #27B8D6; border: 1px solid rgba(39, 184, 214, 0.25);">@(stripePub.Substring(0, Math.Min(24, stripePub.Length)))...</code></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-alt-accordion-btn {
        background: rgba(6, 35, 48, 0.95) !important;
        color: #FFFFFF !important;
        box-shadow: none !important;
    }
    .custom-alt-accordion-btn::after {
        filter: invert(1) brightness(2);
    }
    .custom-alt-accordion-btn:not(.collapsed) {
        background: rgba(6, 35, 48, 0.95) !important;
        color: #27B8D6 !important;
        box-shadow: none !important;
    }
    .channel-option:hover {
        border-color: #27B8D6 !important;
        background: rgba(10, 48, 66, 0.95) !important;
    }
    .channel-option input[type="radio"]:checked + span {
        color: #FFFFFF !important;
    }
</style>

<script>
    function applyStripeTestCase(scenario) {
        var card = document.getElementById('cardNumber');
        var mm = document.getElementById('expMonth');
        var yy = document.getElementById('expYear');
        var cvc = document.getElementById('cvc');
        var feedback = document.getElementById('testCaseFeedback');

        mm.value = '12';
        yy.value = '2028';
        cvc.value = '123';

        switch (scenario) {
            case 'visa_success':
                card.value = '4242 4242 4242 4242';
                feedback.className = 'small text-success mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-check-circle me-1"></i> Pre-configured for immediate successful payment & classroom unlock.';
                break;
            case 'mastercard_success':
                card.value = '5555 5555 5555 4444';
                feedback.className = 'small text-success mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-check-circle me-1"></i> Mastercard test card configured for successful authorization.';
                break;
            case 'declined':
                card.value = '4000 0000 0000 0002';
                feedback.className = 'small text-danger mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-x-circle me-1"></i> Tests gateway card decline error handling ("Your card was declined").';
                break;
            case 'insufficient_funds':
                card.value = '4000 0000 0000 9995';
                feedback.className = 'small text-warning mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> Tests insufficient funds error handling.';
                break;
            case 'expired':
                card.value = '4000 0000 0000 0069';
                feedback.className = 'small text-danger mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-x-circle me-1"></i> Tests expired card rejection handling.';
                break;
            case 'incorrect_cvc':
                card.value = '4000 0000 0000 0127';
                cvc.value = '999';
                feedback.className = 'small text-danger mt-1 fw-semibold';
                feedback.innerHTML = '<i class="bi bi-x-circle me-1"></i> Tests incorrect CVC security code failure.';
                break;
        }
    }
</script>
