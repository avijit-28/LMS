@model LMS.Models.Course
@{
    ViewBag.Title = "Secure Checkout - " + Model.Title;
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Courses")" class="text-decoration-none text-info">Courses</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Details", "Courses", new { id = Model.CourseId })" class="text-decoration-none text-info">@Model.Title</a></li>
                <li class="breadcrumb-item active text-white-50" aria-current="page">Checkout</li>
            </ol>
        </nav>

        <div class="row g-4">
            <!-- Course Summary -->
            <div class="col-md-5 order-md-2">
                <div class="card card-custom p-4 shadow-sm text-white payment-summary-card" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25); border-radius: 16px;">
                    <h5 class="fw-bold mb-3 text-white"><i class="bi bi-cart3 me-2 text-info"></i> Order Summary</h5>
                    <div class="p-3 rounded-3 mb-3" style="background: rgba(4, 24, 34, 0.9); border: 1px solid rgba(39, 184, 214, 0.35);">
                        <h6 class="fw-bold mb-2 text-white fs-6">@Model.Title</h6>
                        <span class="badge px-2 py-1 rounded-pill fw-semibold" style="background: rgba(255, 122, 0, 0.2); color: #FF7A00; border: 1px solid rgba(255, 122, 0, 0.4);">
                            @(Model.Category?.CategoryName ?? "General")
                        </span>
                        <div class="small mt-2" style="color: #94A3B8;">
                            <i class="bi bi-clock me-1 text-info"></i> @Model.DurationInHours Hours Content &bull; Lifetime Access
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small" style="color: #94A3B8;">
                        <span>Curriculum Access</span>
                        <span class="text-white fw-semibold"><span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small" style="color: #94A3B8;">
                        <span>Verifiable Certificate</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small" style="color: #94A3B8;">
                        <span>Platform Discount</span>
                        <span class="text-success"><span class="rupee-symbol">&#8377;</span>0.00</span>
                    </div>
                    <hr class="my-2" style="border-color: rgba(255, 255, 255, 0.15);">
                    <div class="d-flex justify-content-between fs-4 fw-extrabold text-white mb-4">
                        <span>Total Due</span>
                        <span class="fw-bold text-cyan"><span class="rupee-symbol">&#8377;</span>@Model.Price.ToString("N2")</span>
                    </div>

                    <div class="p-3 rounded-3 small d-flex align-items-center gap-2" style="background: rgba(4, 24, 34, 0.75); border: 1px solid rgba(255, 255, 255, 0.12); color: #E2E8F0;">
                        <i class="bi bi-shield-check text-success fs-3"></i>
                        <span>Instant automated enrollment and full classroom unlock.</span>
                    </div>
                </div>
            </div>

            <!-- Payment Form -->
            <div class="col-md-7 order-md-1">
                <div class="card card-custom p-4 p-md-5 shadow-sm text-white" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25); border-radius: 16px;">
                    <h4 class="fw-extrabold mb-1 tracking-tight text-white">Payment Method</h4>
                    <p class="small mb-4" style="color: #94A3B8;">Select your preferred payment channel to finalize your enrollment.</p>

                    @using (Html.BeginForm("Purchase", "Courses", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@Model.CourseId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-white mb-2">Select Payment Option:</label>
                            <div class="d-flex flex-column gap-2">
                                <label class="form-check p-3 rounded-3 d-flex align-items-center mb-0" for="pmCard" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(39, 184, 214, 0.3); cursor: pointer;">
                                    <input class="form-check-input me-3 mt-0" type="radio" name="paymentMethod" id="pmCard" value="Credit Card (Mock / Test)" checked style="cursor: pointer;">
                                    <span class="form-check-label fw-bold text-white">
                                        <i class="bi bi-credit-card-2-front text-info me-2 fs-5"></i> Credit / Debit Card (Sandbox Test)
                                    </span>
                                </label>
                                <label class="form-check p-3 rounded-3 d-flex align-items-center mb-0" for="pmUPI" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(39, 184, 214, 0.3); cursor: pointer;">
                                    <input class="form-check-input me-3 mt-0" type="radio" name="paymentMethod" id="pmUPI" value="UPI / QR Payment (Mock)" style="cursor: pointer;">
                                    <span class="form-check-label fw-bold text-white">
                                        <i class="bi bi-qr-code-scan text-success me-2 fs-5"></i> UPI / QR Code (Google Pay, PhonePe, Paytm)
                                    </span>
                                </label>
                                <label class="form-check p-3 rounded-3 d-flex align-items-center mb-0" for="pmNetBanking" style="background: rgba(6, 35, 48, 0.9); border: 1px solid rgba(39, 184, 214, 0.3); cursor: pointer;">
                                    <input class="form-check-input me-3 mt-0" type="radio" name="paymentMethod" id="pmNetBanking" value="Net Banking (Mock)" style="cursor: pointer;">
                                    <span class="form-check-label fw-bold text-white">
                                        <i class="bi bi-bank text-info me-2 fs-5"></i> Net Banking (All Indian Banks)
                                    </span>
                                </label>
                            </div>
                        </div>

                        <div class="alert alert-warning small border-warning border-0 border-start border-4 border-warning bg-warning bg-opacity-10 text-white p-3 rounded-3 mb-4">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-info-circle-fill text-warning fs-5"></i>
                                <div>
                                    <strong class="text-warning">Development Sandbox Environment:</strong> This payment flow runs in simulated demo mode. No sensitive financial credentials are requested or stored. Submitting generates a genuine database payment record and unlocks student enrollment.
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn w-100 py-3 rounded-pill fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #FF7A00, #E65100); border: none;">
                            <i class="bi bi-lock-fill me-1"></i> Authorize Payment & Start Learning
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>